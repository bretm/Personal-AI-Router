[Unit]
Description=NVIDIA Personal AI Router
Documentation=https://github.com/NVIDIA/Personal-AI-Router
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@NVPAIR_BIN_DIR@
LoadCredentialEncrypted=lemonade-api-key
ExecStart=/bin/sh -c '\
credential_path="$${CREDENTIALS_DIRECTORY}/lemonade-api-key"; \
if [ ! -s "$${credential_path}" ]; then \
    echo "missing Lemonade API credential: install encrypted credential lemonade-api-key" >&2; \
    exit 1; \
fi; \
LEMONADE_API_KEY="$$(cat "$${credential_path}")"; \
export LEMONADE_API_KEY; \
unset credential_path; \
exec "@NVPAIR_BIN_DIR@/nvpair-ui-broker" --headless'
Restart=on-failure
RestartSec=3s
KillMode=mixed
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=default.target
